{
  "name": "@kidcash/ui",
  "version": "0.1.0",
  "description": "Playful React components for family-finance and kid-focused apps. Extracted from KidCash.",
  "license": "MIT",
  "homepage": "https://kit.kidcashapp.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/simsketch/kidcash-ui.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "framer-motion",
    "kids",
    "family",
    "finance",
    "allowance",
    "celebration"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "public",
    "src/styles/preset.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset.css": "./src/styles/preset.css",
    "./mascot.png": "./public/mascot-astronaut.png"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "framer-motion": "^11.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
